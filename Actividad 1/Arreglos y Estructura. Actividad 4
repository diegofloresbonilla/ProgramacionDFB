 * Actividad 1 - Programación
 *
 * PROBLEMA QUE RESUELVE:
 * Este programa calcula correctamente el límite de una sucesión
 * utilizando BigInteger para evitar errores de precisión y overflow.
 *
 * Se aplica un criterio de paro basado en epsilon (criterio de Cauchy)
 * para determinar cuándo la sucesión converge.
 */

import java.math.BigInteger;

public class SucesionConvergente_v4 {

    public static void main(String[] args) {

        final double EPSILON = 1E-15;

        BigInteger g = new BigInteger("347");
        BigInteger b = new BigInteger("37");
        BigInteger a = new BigInteger("2");

        BigInteger k1 = BigInteger.valueOf(111);
        BigInteger k2 = BigInteger.valueOf(1130);
        BigInteger k3 = BigInteger.valueOf(3000);

        double u_act = 0;
        double u_ant = 0;

        BigInteger tmp;

        int indice = 250;

        for (int i = 4; i <= indice; i++) {

            tmp = g;

            g = g.multiply(k1)
                 .subtract(b.multiply(k2))
                 .add(a.multiply(k3));

            a = b;
            b = tmp;

            u_act = g.doubleValue() / b.doubleValue();

            System.out.printf("Valor en %d es %.20f %n", i, u_act);

            if (Math.abs(u_ant - u_act) <= EPSILON) {
                System.out.println("La sucesión converge a: " + Math.floor(u_act));
                System.out.println("El límite se considera bien calculado en n = " + i);
                break;
            }

            u_ant = u_act;
        }
    }
}

