/**
 * Actividad 1 - Programación
 *
 * PROBLEMA QUE RESUELVE:
 * Implementa una estructura para manejar arreglos de enteros,
 * incluyendo algoritmos de ordenamiento (Bubble, Selection, Insertion),
 * así como métodos para obtener máximo, mínimo, promedio y mostrar el arreglo.
 */

public class Estructura_ManejoDatos {

    private int[] data;

    public Estructura_ManejoDatos(int[] arr) {
        this.data = arr.clone();
    }

    public void setData(int[] arr) {
        this.data = arr.clone();
    }

    public void bubbleSort() {
        for (int i = 0; i < data.length - 1; i++) {
            for (int j = 0; j < data.length - i - 1; j++) {
                if (data[j] > data[j + 1]) {
                    int temp = data[j];
                    data[j] = data[j + 1];
                    data[j + 1] = temp;
                }
            }
        }
    }

    public void selectionSort() {
        for (int i = 0; i < data.length - 1; i++) {
            int min = i;
            for (int j = i + 1; j < data.length; j++) {
                if (data[j] < data[min]) {
                    min = j;
                }
            }
            int temp = data[i];
            data[i] = data[min];
            data[min] = temp;
        }
    }

    public void insertionSort() {
        for (int i = 1; i < data.length; i++) {
            int key = data[i];
            int j = i - 1;

            while (j >= 0 && data[j] > key) {
                data[j + 1] = data[j];
                j--;
            }

            data[j + 1] = key;
        }
    }

    public int max() {
        int max = data[0];
        for (int i = 1; i < data.length; i++) {
            if (data[i] > max) max = data[i];
        }
        return max;
    }

    public int min() {
        int min = data[0];
        for (int i = 1; i < data.length; i++) {
            if (data[i] < min) min = data[i];
        }
        return min;
    }

    public double average() {
        int sum = 0;
        for (int x : data) sum += x;
        return (double) sum / data.length;
    }

    public void displayArray() {
        System.out.print("[ ");
        for (int i = 0; i < data.length; i++) {
            System.out.print(data[i] + " ");
        }
        System.out.println("]");
    }

    public void sortAndDisplay(String method) {

        if (method.equalsIgnoreCase("bubble")) {
            System.out.println("Usando BubbleSort");
            bubbleSort();
        } else if (method.equalsIgnoreCase("selection")) {
            System.out.println("Usando SelectionSort");
            selectionSort();
        } else if (method.equalsIgnoreCase("insertion")) {
            System.out.println("Usando InsertionSort");
            insertionSort();
        }

        displayArray();
    }
}

