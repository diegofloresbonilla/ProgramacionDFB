/**
 * Actividad 1 - Programación
 *
 * PROBLEMA QUE RESUELVE:
 * Modificación del programa de sucesión para almacenar los valores
 * en un arreglo y permitir al usuario consultar una posición específica.
 */

import java.math.BigInteger;
import java.util.Scanner;

public class SucesionConvergenteArreglo {

    public static void main(String[] args) {

        final double EPSILON = 1E-15;

        BigInteger g = new BigInteger("347");
        BigInteger b = new BigInteger("37");
        BigInteger a = new BigInteger("2");

        BigInteger k1 = BigInteger.valueOf(111);
        BigInteger k2 = BigInteger.valueOf(1130);
        BigInteger k3 = BigInteger.valueOf(3000);

        double u_act = 0;
        double u_ant = 0;

        BigInteger tmp;

        int indice = 250;
        double[] valores = new double[indice + 1];
        int ultimoIndiceCalculado = 0;

        for (int i = 4; i <= indice; i++) {

            tmp = g;

            g = g.multiply(k1)
                 .subtract(b.multiply(k2))
                 .add(a.multiply(k3));

            a = b;
            b = tmp;

            u_act = g.doubleValue() / b.doubleValue();
            valores[i] = u_act;
            ultimoIndiceCalculado = i;

            if (Math.abs(u_ant - u_act) <= EPSILON) {
                break;
            }

            u_ant = u_act;
        }

        Scanner entrada = new Scanner(System.in);

        System.out.print("¿Qué posición quieres consultar? ");
        int posicion = entrada.nextInt();

        if (posicion >= 4 && posicion <= ultimoIndiceCalculado) {
            System.out.println("Valor: " + valores[posicion]);
        } else {
            System.out.println("Posición inválida");
        }

        entrada.close();
    }
}

