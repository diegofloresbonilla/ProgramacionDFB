public class Cuadrado_Swing extends JFrame {

    public void paint(Graphics g) {
        super.paint(g);

        // Cuadrado original
        g.setColor(Color.RED);
        g.fillRect(50, 50, 200, 200);

        // Rectángulo borrado dentro del cuadrado
        g.clearRect(100, 100, 100, 100);

        // 1. Elipse
        g.setColor(Color.BLUE);
        g.drawOval(280, 70, 150, 80);

        // 2. Arco
        g.setColor(Color.GREEN);
        g.drawArc(280, 180, 150, 100, 0, 180);

        // 3. Triángulo
        g.setColor(Color.MAGENTA);
        int[] xPoints = {120, 60, 180};
        int[] yPoints = {320, 420, 420};
        g.drawPolygon(xPoints, yPoints, 3);
    }
}


