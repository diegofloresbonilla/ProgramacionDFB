import numpy as np
import matplotlib.pyplot as plt

# ==============================
# Proyecto 1:
# Crecimiento del volumen de un tumor
# Método de Euler hacia adelante
# ==============================

# Parámetros
r = 4
a = 1
b = 4
c = 1
d = 1

# Función g(t)
def g(t):
    return t**2

# Intervalo de tiempo
n = 200
t = np.linspace(0, 2, n)
h = t[1] - t[0]

# Matriz para guardar V(t) y B(t)
# fila 0 -> V(t)
# fila 1 -> B(t)
VB = np.zeros((2, n))

# Condiciones iniciales
VB[0][0] = 1   # V(0)
VB[1][0] = 2   # B(0)

# Método de Euler hacia adelante
for i in range(n - 1):
    V = VB[0][i]
    B = VB[1][i]

    dV = r * V * (1 - V / B)
    dB = -a * B + b * V - c * B * (V ** (2/3)) - d * B * g(t[i])

    VB[0][i + 1] = V + h * dV
    VB[1][i + 1] = B + h * dB

# Gráfica de V(t) y B(t) en el mismo frame
plt.plot(t, VB[0], label="V(t) Volumen del tumor")
plt.plot(t, VB[1], label="B(t) Densidad de vasos sanguíneos")

plt.title("Crecimiento del volumen de un tumor")
plt.xlabel("Tiempo t")
plt.ylabel("V(t) y B(t)")
plt.legend()
plt.grid()
plt.show()


