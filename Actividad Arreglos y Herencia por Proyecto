import javax.swing.*;
import java.awt.*;

public class ArbolDePitagorasGeneral extends JFrame {

    double theta;

    public ArbolDePitagorasGeneral(double theta) {
        this.theta = Math.toRadians(theta);
    }

    public void paint(Graphics g) {

        g.clearRect(0, 0, 500, 500);

        paintTree(g, 210, 400, 290, 400);
    }

    void paintTree(Graphics g,
                   double x1, double y1,
                   double x2, double y2) {

        double dx = x1 - x2;
        double dy = y1 - y2;

        if(dx * dx + dy * dy > 10){

            double x3 = x1 - dy;
            double y3 = y1 + dx;

            double x4 = x2 - dy;
            double y4 = y2 + dx;

            // Vector superior del cuadrado
            double vx = x4 - x3;
            double vy = y4 - y3;

            // Rotación por ángulo theta
            double x5 = x3 +
                        vx * Math.cos(theta) -
                        vy * Math.sin(theta);

            double y5 = y3 +
                        vx * Math.sin(theta) +
                        vy * Math.cos(theta);

            // Dibujar cuadrado
            g.drawLine((int)x1, (int)y1,
                       (int)x2, (int)y2);

            g.drawLine((int)x2, (int)y2,
                       (int)x4, (int)y4);

            g.drawLine((int)x4, (int)y4,
                       (int)x3, (int)y3);

            g.drawLine((int)x3, (int)y3,
                       (int)x1, (int)y1);

            // Recursividad
            paintTree(g, x3, y3, x5, y5);
            paintTree(g, x5, y5, x4, y4);
        }
    }
}


