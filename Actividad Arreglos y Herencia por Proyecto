function getSignificantCover(pixel){
  var r,g,b, arraySigColor;

  r = pixel.getRed();
  g = pixel.getGreen();
  b = pixel.getBlue();

  r = Math.floor(r/32);
  g = Math.floor(g/32);
  b = Math.floor(b/32);

  arraySigColor = [r,g,b];
  return arraySigColor;
}

function getSignificantHide(pixel){
  var r,g,b, arraySigColor;

  r = pixel.getRed();
  g = pixel.getGreen();
  b = pixel.getBlue();

  r = Math.floor(r/8);
  g = Math.floor(g/8);
  b = Math.floor(b/8);

  arraySigColor = [r,g,b];
  return arraySigColor;
}

function getMessage(){
